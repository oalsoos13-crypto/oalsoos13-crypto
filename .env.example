# --- UDC Debit Note System configuration ---
# Copy to .env and adjust for your environment.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# SQLite database file (created automatically).
DB_FILE=./data/udc.db

# REQUIRED in production: a long random string.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# bcrypt work factor (10-12 recommended).
BCRYPT_ROUNDS=10

# Default password seeded for new users (they must change it on first login).
DEFAULT_PASSWORD=Udc@1234
# Optional dedicated admin password.
ADMIN_PASSWORD=Udc@Admin1

# Document numbering.
START_COUNTER=11251
REF_YEAR=2026

# Max request body (attachments are base64 data URLs).
BODY_LIMIT=25mb
